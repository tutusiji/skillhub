[Unit]
Description=SkillHub Enterprise Server (NestJS API + Git marketplace + static SPA)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/tutuos/CodeLab/gemini-skillhub/server
ExecStart=/home/tutuos/.nvm/versions/node/v22.22.3/bin/node dist/main
Environment="NODE_ENV=production"
Environment="PORT=3001"
Environment="PATH=/home/tutuos/.nvm/versions/node/v22.22.3/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Restart=always
RestartSec=5
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=skillhub-server

[Install]
WantedBy=default.target
