# ─────────────────────────────────────────────────────────
# SkillHub 环境配置示例
#
# 配置分层（后端进程工作目录为 server/，文件均在 server/ 下）：
#   .env          通用配置（提交入库，本地开发默认值，不含任何真实密钥）
#   .env.local    本机覆盖（不入库）
#   .env.<APP_ENV> 按环境加载（如 .env.test / .env.prod，不入库，内网各环境地址写这里）
#
# 加载顺序（后者覆盖前者）：.env → .env.local → .env.<APP_ENV>
# 启动时用 APP_ENV 选择环境：
#   APP_ENV=prod pnpm run server:start      # 生产
#   APP_ENV=test pnpm run server:start      # 测试
#   APP_ENV=dev  pnpm run server:start      # 开发（默认）
# ─────────────────────────────────────────────────────────

# 当前运行环境：dev / test / prod（缺省 dev）
APP_ENV=dev

# ─────────────────────────────────────────────────────────
# PostgreSQL 数据库连接（数据库统一使用 PostgreSQL）
# 内网 dev / test / prod 三套 PG 地址分别写入 .env / .env.test / .env.prod，
# 例如生产（.env.prod）：
#   DB_HOST=pg-prod.internal.corp
#   DB_PORT=5432
#   DB_USER=skillhub
#   DB_PASSWORD=only-in-env-file
#   DB_NAME=skillhub
# 或用 DATABASE_URL 一次性指定（优先级高于上面四项）：
#   DATABASE_URL=postgres://skillhub:pass@pg-prod.internal.corp:5432/skillhub
# ─────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=skillhub
DB_PASSWORD=change-me
DB_NAME=skillhub
DATABASE_URL=

# ─────────────────────────────────────────────────────────
# 内部 IAM 单点登录（OSS 登录）
# 留空时使用本地桩实现：接受 7 位数字工号并自动开号。
# ─────────────────────────────────────────────────────────
IAM_BASE_URL=""
IAM_API_TOKEN=""
IAM_TIMEOUT_MS="5000"

# ─────────────────────────────────────────────────────────
# LLM 审核引擎（双引擎中的「语义研判引擎」）
# 支持任意 OpenAI 兼容网关：通义千问（百炼兼容模式）/ DeepSeek / vLLM / 内网自建代理
# 三项均可留空：留空时语义引擎自动降级为本地启发式规则，审核链路不中断。
# ─────────────────────────────────────────────────────────
LLM_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
LLM_MODEL_NAME="qwen-plus"
LLM_API_KEY=""
