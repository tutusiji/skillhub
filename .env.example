# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SkillHub frontend API endpoint (omit trailing slash).
VITE_API_BASE_URL="http://localhost:3001"

# ─────────────────────────────────────────────────────────
# 内部 IAM 单点登录（OSS 登录）
# 留空时使用本地桩实现：接受 7 位数字工号并自动开号，便于无内网环境完整体验。
# 配置后改为调用真实 IAM 接口校验工号（见 server/src/modules/auth/oss-iam.service.ts）。
# 三个变量均可留空。
# ─────────────────────────────────────────────────────────
IAM_BASE_URL=""
IAM_API_TOKEN=""
IAM_TIMEOUT_MS="5000"

# ─────────────────────────────────────────────────────────
# LLM 审核引擎（双引擎中的「语义研判引擎」）
# 支持任意 OpenAI 兼容网关：通义千问（百炼兼容模式）/ DeepSeek / vLLM / 内网自建代理
# 三项均可留空：留空时语义引擎自动降级为本地启发式规则，审核链路不中断。
# 首次启动时会把这里的值播种进数据库，之后由「风控中心 → 大模型网关」界面维护。
# ─────────────────────────────────────────────────────────
LLM_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
LLM_MODEL_NAME="qwen-plus"
LLM_API_KEY=""
