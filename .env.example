# ─────────────────────────────────────────────────────────
# SkillHub 环境配置示例
#
# 配置分层（后端进程工作目录为 server/，文件均在 server/ 下）：
#   .env          通用配置（提交入库，本地开发默认值，不含任何真实密钥）
#   .env.local    本机覆盖（不入库）
#   .env.<APP_ENV> 按环境加载（如 .env.test / .env.prod，不入库，内网各环境地址写这里）
#
# 加载顺序（后者覆盖前者）：.env → .env.local → .env.<APP_ENV>
# 启动时用 APP_ENV 选择环境：
#   APP_ENV=prod pnpm run server:start      # 生产
#   APP_ENV=test pnpm run server:start      # 测试
#   APP_ENV=dev  pnpm run server:start      # 开发（默认）
# ─────────────────────────────────────────────────────────

# 当前运行环境：dev / test / prod（缺省 dev）
APP_ENV=dev

# ─────────────────────────────────────────────────────────
# PostgreSQL 数据库连接（数据库统一使用 PostgreSQL）
# 内网 dev / test / prod 三套 PG 地址分别写入 .env / .env.test / .env.prod，
# 例如生产（.env.prod）：
#   DB_HOST=pg-prod.internal.corp
#   DB_PORT=5432
#   DB_USER=skillhub
#   DB_PASSWORD=only-in-env-file
#   DB_NAME=skillhub
# 或用 DATABASE_URL 一次性指定（优先级高于上面四项）：
#   DATABASE_URL=postgres://skillhub:pass@pg-prod.internal.corp:5432/skillhub
# ─────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=skillhub
DB_PASSWORD=change-me
DB_NAME=skillhub
DATABASE_URL=

# ─────────────────────────────────────────────────────────
# 内部 IAM 单点登录（OSS 登录）
# 留空时使用本地桩实现：接受 7 位数字工号并自动开号。
# ─────────────────────────────────────────────────────────
IAM_BASE_URL=""
IAM_API_TOKEN=""
IAM_TIMEOUT_MS="5000"

# ─────────────────────────────────────────────────────────
# 头像服务（DiceBear 协议）
#
# 头像不存图片，而是按稳定 seed 实时生成矢量头像，URL 形态：
#   {BASE}/{STYLE}/svg?seed={工号}
# seed 取值优先级：工号 → 登录名 → 邮箱 → 姓名（同一个人头像终身不变）。
#
# 外网/公网环境（默认，留空即用官方公共服务）：
#   AVATAR_BASE_URL=https://api.dicebear.com/10.x
# 内网自建服务（注意版本段可能与官方不同，按实际服务填）：
#   AVATAR_BASE_URL=http://10.9.43.61:4987/9.x
#
# 切换 host 后重启后端即可：启动期 reconcile 会把「系统自动生成的头像」
# （含早期 Unsplash 外链与上一次部署的 DiceBear 地址）批量重写到新 base，
# 用户自己上传/手填的头像不会被动。无需执行数据迁移脚本。
#
# 前端另有一份同名配置（VITE_ 前缀，构建期常量），两边必须填同一个地址：
#   VITE_AVATAR_BASE_URL / VITE_AVATAR_STYLE
# 前端仅在后端未返回头像时兜底使用。
# ─────────────────────────────────────────────────────────
AVATAR_BASE_URL="https://api.dicebear.com/10.x"
AVATAR_STYLE="adventurer"

VITE_AVATAR_BASE_URL="https://api.dicebear.com/10.x"
VITE_AVATAR_STYLE="adventurer"

# ─────────────────────────────────────────────────────────
# LLM 审核引擎（双引擎中的「语义研判引擎」）
# 支持任意 OpenAI 兼容网关：通义千问（百炼兼容模式）/ DeepSeek / vLLM / 内网自建代理
# 三项均可留空：留空时语义引擎自动降级为本地启发式规则，审核链路不中断。
# ─────────────────────────────────────────────────────────
LLM_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
LLM_MODEL_NAME="qwen-plus"
LLM_API_KEY=""

# ─────────────────────────────────────────────────────────
# 安全相关（生产环境必读）
#
# JWT_SECRET —— JWT 签名密钥。生产环境（APP_ENV=prod）**必须**显式配置且不少于
# 32 字符，否则服务拒绝启动：源码内的历史默认值是公开的，任何人都能用它自签一个
# role=super_admin 的令牌，等同于全站无鉴权。生成方式：
#   JWT_SECRET=$(openssl rand -hex 32)
JWT_SECRET=""

# 令牌有效期（默认 12h）。前端只在 localStorage 存令牌、没有刷新令牌机制，
# 有效期越长，一次令牌泄露的可利用窗口越大。
JWT_EXPIRES_IN="12h"

# 允许跨域访问的来源白名单（逗号分隔）。留空时：
#   生产 → 仅同源（后端已托管前端静态资源，通常无需放开）
#   开发 → 回显请求来源，便于 Vite dev server 直连
# 例：CORS_ORIGINS=https://skillhub.internal.corp,https://skillhub-test.internal.corp
CORS_ORIGINS=""

# 是否播种演示数据（模拟员工 / 演示技能 / 演示建议 / 预置种子技能）。
# 留空时按环境自动判定：生产关闭、其他环境开启。
# 演示账号共用弱口令 Password123!，生产环境开启等于放了一组可直接登录的后门账号。
# 注意：超级管理员账号 (admin) 不受该开关影响，任何环境都会确保存在。
SEED_DEMO_DATA=""
