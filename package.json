    "server:start": "pnpm --filter skillhub-server run start:prod",
    "test:regression": "node scripts/regression-test.mjs",
    "test:plugin-e2e": "bash scripts/claude-plugin-e2e.sh",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "pnpm run lint && pnpm run test:unit && pnpm run test:regression && pnpm run test:plugin-e2e && pnpm run test:e2e"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.3.7",
